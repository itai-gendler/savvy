[Unit]
Description=Savvy stopped-state database backup
After=network-online.target
RequiresMountsFor=/var/lib/savvy /var/backups/savvy

[Service]
Type=oneshot
Environment=SAVVY_AUTH_DATABASE=/var/lib/savvy/auth.sqlite
Environment=SAVVY_DB_PATH=/var/lib/savvy/service.sqlite
Environment=SAVVY_HOST=127.0.0.1
Environment=PORT=8788
ExecStart=/usr/local/libexec/savvy-backup backup
# Runs after successful backup, command failure or termination of the backup process.
ExecStopPost=/usr/local/libexec/savvy-backup restart
RuntimeDirectory=savvy-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=300
TimeoutStopSec=180
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/savvy /var/backups/savvy
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
